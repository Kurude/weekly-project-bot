# Google Gemini API key (free tier - console.aistudio.google.com se banao, koi card nahi chahiye)
GEMINI_API_KEY=AIzaSyxxxxxxxx

# GitHub Personal Access Token (repo scope) — issue banane aur naye repo push karne ke liye
# Default GITHUB_TOKEN se naya repo nahi ban sakta account mein, isliye PAT chahiye
GH_PAT=ghp_xxxxxxxx

# Orchestration repo (jahan Issues create honge) — format: owner/repo
ORCHESTRATION_REPO=yourusername/weekly-project-bot

# Naye generated projects kis GitHub account/org ke under banenge
GITHUB_USERNAME=yourusername
